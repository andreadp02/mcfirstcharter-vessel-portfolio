{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mcfirstcharter-vessel-portfolio",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
